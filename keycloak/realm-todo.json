{
  "realm": "todo",
  "enabled": true,
  "displayName": "To-Do App",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "passwordPolicy": "length(8)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "clients": [
    {
      "clientId": "todo-app",
      "name": "To-Do App (FastAPI BFF)",
      "description": "Confidential OIDC client used by FastAPI (Authorization Code + PKCE)",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${TODO_APP_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": ["http://${PUBLIC_HOST}/api/auth/callback"],
      "webOrigins": ["http://${PUBLIC_HOST}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://${PUBLIC_HOST}/*"
      },
      "defaultClientScopes": ["basic", "acr", "profile", "email", "roles", "web-origins"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-todo-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "todo-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "todo-e2e",
      "name": "To-Do E2E tests",
      "description": "Test-only client (password grant) used by e2e/e2e_test.py",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${TODO_E2E_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["basic", "acr", "profile", "email"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-todo-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "todo-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${ALICE_PASSWORD}", "temporary": false }]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${BOB_PASSWORD}", "temporary": false }]
    }
  ]
}
