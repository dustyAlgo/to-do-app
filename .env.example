# Copy to .env on the VM (Phases 1–5):   cp .env.example .env && chmod 600 .env
# From Phase 6 the CodeDeploy hook writes .env from SSM Parameter Store (/todo/*) instead.
# Use URL-safe characters only (A-Z a-z 0-9 - _) — the DB passwords are embedded in a connection URL.

# ---- Public address -------------------------------------------------------
# TODO(phase 0): replace with your Elastic IP, e.g. 13.233.10.20.nip.io
PUBLIC_HOST=<EIP>.nip.io

# ---- Keycloak (upstream IdP) ----------------------------------------------
KEYCLOAK_ADMIN_PASSWORD=<change-me>
KEYCLOAK_DB_PASSWORD=<change-me>

# Injected into keycloak/realm-todo.json at first import AND given to FastAPI.
# Generate: python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
TODO_APP_CLIENT_SECRET=<change-me>
TODO_E2E_CLIENT_SECRET=<change-me>

# Demo users created by the realm import
ALICE_PASSWORD=<change-me-min-8-chars>
BOB_PASSWORD=<change-me-min-8-chars>

# ---- App database ---------------------------------------------------------
APP_DB_PASSWORD=<change-me>

# ---- Images (Phase 6 — written by CodeBuild into deploy.env) --------------
# Leave as-is for local builds on the VM.
ECR_REGISTRY=local
IMAGE_TAG=dev
AWS_REGION=ap-south-1
